# کپی کنید به .env و مقادیر را تغییر دهید (فایل .env را هرگز commit نکنید)

# پورت سرور
PORT=3000

# نام بازی (موقت؛ از اینجا قابل تغییر است)
GAME_NAME=Project Arena

# development | production
NODE_ENV=development

# مبدأهای مجاز برای Socket.IO (با ویرگول جدا کنید). خالی = فقط همان مبدأ
CORS_ORIGIN=

# سطح لاگ: debug | info | warn | error
LOG_LEVEL=info
